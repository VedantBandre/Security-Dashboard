# Example only: set actual values in your host's secret/environment settings.
DJANGO_ENV=production
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=security-demo.example.com
DB_ENGINE=postgresql
DB_NAME=security_dashboard
DB_USER=security_dashboard
DB_PASSWORD=
DB_HOST=
DB_PORT=5432
DB_SSLMODE=require
# Enable only behind an ingress that removes untrusted forwarded headers,
# sets X-Forwarded-Proto, and prevents direct public access to Gunicorn.
DJANGO_TRUST_PROXY=false
DJANGO_PROXY_COUNT=0
# Enable only if every subdomain is HTTPS. HSTS preload remains disabled.
DJANGO_HSTS_INCLUDE_SUBDOMAINS=false
PORT=8000
WEB_CONCURRENCY=2
